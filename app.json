{
  "expo": {
    "name": "Hub & Tools",
    "slug": "hub-tools",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Камера нужна для верификации и загрузки документов в WebView.",
        "NSPhotoLibraryUsageDescription": "Доступ к фото нужен для загрузки файлов в платёжных и регистрационных формах.",
        "NSMicrophoneUsageDescription": "Микрофон может потребоваться для верификации в WebView."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B1026",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Доступ к фото нужен для загрузки файлов в WebView.",
          "cameraPermission": "Камера нужна для верификации в WebView."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0961eb61-4427-4917-ae86-ac3ddb4c2359"
      }
    },
    "owner": "jungler132",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0961eb61-4427-4917-ae86-ac3ddb4c2359"
    }
  }
}
